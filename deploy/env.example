# Vorlage fuer die Secrets. NUR Namen und Platzhalter, keine echten Werte.
# Echte Werte gehoeren in die lokalen Windows-User-Umgebungsvariablen (nicht ins Repo).
# deploy.ps1 liest genau diese fuenf Namen und uebertraegt sie als ~/easee-ha-ocpp.env (Rechte 600).
HA_TOKEN=<langlebiger-home-assistant-token>
EASEE_USERNAME=<easee-account-email>
EASEE_PASSWORD=<easee-account-passwort>
OCPP_BASIC_AUTH_PASSWORD=<16-40-zeichen-zufall>
KEYSTORE_PASSWORD=<16-40-zeichen-zufall>
